{
  "name": "smdc_portal",
  "description": "SMDC Portal to connect SMDC apps into central location.",
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run tauri build",
    "build:bun": "bun run tauri build",
    "build:debug": "npm run tauri build -- --debug",
    "build:bun:debug": "bun run tauri build --debug",
    "qwik:build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "tauri": "tauri",
    "clean": "rm package-lock.json ./src-tauri/Cargo.lock || true && (rm -rf node_modules dist tmp server src-tauri/target || @powershell rm -recurse node_modules dist tmp server src-tauri/target)"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.11.0",
    "@builder.io/qwik-city": "^1.11.0",
    "@types/eslint": "9.6.1",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@typescript-eslint/utils": "8.18.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.22",
    "eslint": "9.17.0",
    "eslint-plugin-qwik": "^1.11.0",
    "postcss": "^8.4.49",
    "prettier": "3.4.2",
    "sweetalert2": "11.15.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "5.7.2",
    "undici": "7.1.1",
    "uuid": "^11.0.3",
    "vite": "6.0.3",
    "vite-tsconfig-paths": "5.1.4"
  },
  "dependencies": {
    "@tauri-apps/api": "2.1.1",
    "@tauri-apps/cli": "2.1.0",
    "@tauri-apps/plugin-shell": "2.2.0"
  }
}
