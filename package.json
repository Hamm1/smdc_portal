{
  "name": "smdc_portal",
  "description": "SMDC Portal to connect SMDC apps into central location.",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "type": "module",
  "private": true,
  "trustedDependencies": [
    "sharp"
  ],
  "scripts": {
    "build": "npm run tauri build",
    "build:bun": "bun run tauri build",
    "build:npm:debug": "npm run tauri build -- --debug",
    "build:bun:debug": "bun run tauri build --debug",
    "qwik:build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"bun run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "biome format --write ./src",
    "fmt.check": "biome check --write ./src",
    "lint": "biome lint ./src",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "tauri": "tauri",
    "clean": "rm package-lock.json ./src-tauri/Cargo.lock || true && (rm -rf node_modules dist tmp server out .ci/out src-tauri/target || @powershell rm -recurse node_modules dist tmp server out .ci/out src-tauri/target)",
    "dagger:windows": "cd .ci && pwsh ./dagger.ps1",
    "dagger:linux": "cd .ci && sh ./dagger.sh",
    "dagger": "bun run dagger:windows || bun run dagger:linux"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.12.0",
    "@builder.io/qwik-city": "^1.12.0",
    "@types/node": "^22.10.10",
    "@types/uuid": "^10.0.0",
    "@biomejs/biome": "1.9.4",
    "bun-types": "1.2.0",
    "daisyui": "5.0.0-beta.2",
    "eslint": "9.19.0",
    "sweetalert2": "11.15.10",
    "tailwindcss": "4.0.0",
    "@tailwindcss/vite": "4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "undici": "7.3.0",
    "uuid": "^11.0.5",
    "vite": "6.0.11",
    "vite-tsconfig-paths": "5.1.4"
  },
  "dependencies": {
    "@tauri-apps/api": "2.2.0",
    "@tauri-apps/cli": "2.2.5",
    "@tauri-apps/plugin-shell": "2.2.0"
  }
}
