{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run qwik:build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "productName": "smdc_portal",
  "version": "0.1.0",
  "identifier": "com.smdc.SMDC-Portal",
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "longDescription": "",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "",
      "targets": ["app","deb","dmg","msi","nsis","rpm"],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "app": {
      "macOSPrivateApi": false,
      "security": {
        "csp": null,
        "assetProtocol": {
          "enable": false,
          "scope": []
        },
        "dangerousDisableAssetCspModification": false,
        "freezePrototype": false,
        "pattern": {
          "use": "brownfield"
        }
      },
      "windows": [
        {
          "fullscreen": false,
          "height": 680,
          "resizable": true,
          "title": "SMDC Portal",
          "width": 850,
          "center": true,
          "decorations": true
        }
      ],
      "withGlobalTauri": true
  }
}
